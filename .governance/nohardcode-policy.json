{
  "schema": "wellmanifest.nohardcode/policy/v1",
  "version": "0.2.0-dev",
  "profile": "balanced",
  "engine_bindings": {
    "llm": {
      "enabled": true,
      "provider": "subllm"
    },
    "vision_yolo": {
      "enabled": false
    },
    "ocr_tesseract": {
      "enabled": false
    },
    "rule_engine_jev": {
      "enabled": true
    },
    "secrets_vault": {
      "enabled": true
    },
    "env_dsl": {
      "enabled": true
    },
    "adaptive_budget": {
      "enabled": true,
      "strategy": "exponential_jitter"
    },
    "schema_extractor": {
      "enabled": true,
      "fallback_to_llm": true,
      "tolerant_tree_traversal": true
    },
    "model_router": {
      "enabled": true,
      "routing_tier": "capability"
    },
    "dag_planner": {
      "enabled": false,
      "standard_ref": "wellmanifest/poa@v1"
    },
    "hardware_probe": {
      "enabled": false,
      "probe_accelerator": true,
      "dynamic_display_detection": true
    },
    "fuzzy_phonetic": {
      "enabled": false,
      "algorithm": "hybrid"
    },
    "adaptive_ranking": {
      "enabled": false,
      "strategy": "thompson_sampling"
    }
  },
  "rules": {
    "NOHARDCODE-001": {
      "enabled": true,
      "severity": "warning"
    },
    "NOHARDCODE-002": {
      "enabled": true,
      "severity": "warning"
    },
    "NOHARDCODE-003": {
      "enabled": true,
      "severity": "warning"
    },
    "NOHARDCODE-004": {
      "enabled": true,
      "severity": "warning"
    },
    "NOHARDCODE-005": {
      "enabled": true,
      "severity": "error"
    },
    "NOHARDCODE-006": {
      "enabled": true,
      "severity": "error"
    },
    "NOHARDCODE-007": {
      "enabled": true,
      "severity": "warning"
    },
    "NOHARDCODE-008": {
      "enabled": true,
      "severity": "warning"
    },
    "NOHARDCODE-009": {
      "enabled": true,
      "severity": "error"
    },
    "NOHARDCODE-010": {
      "enabled": true,
      "severity": "warning"
    },
    "NOHARDCODE-011": {
      "enabled": true,
      "severity": "warning"
    },
    "NOHARDCODE-012": {
      "enabled": true,
      "severity": "warning"
    },
    "NOHARDCODE-013": {
      "enabled": true,
      "severity": "error"
    },
    "NOHARDCODE-014": {
      "enabled": true,
      "severity": "warning"
    },
    "NOHARDCODE-015": {
      "enabled": true,
      "severity": "error"
    },
    "NOHARDCODE-016": {
      "enabled": true,
      "severity": "warning"
    },
    "NOHARDCODE-017": {
      "enabled": true,
      "severity": "warning"
    }
  },
  "exclusions": [
    "tests/**",
    "docs/**",
    "docker/**",
    "project/**",
    ".governance/**",
    ".worktrees/**",
    "venv/**",
    ".venv/**",
    ".git/**"
  ]
}
